# Copy to .env (never commit .env). Everything here is optional: with no keys FINN still
# runs on rules, code and the screener fallback; keys add the model-backed steps.

# --- Model providers (either one is enough; both free tier) ---------------------------
GEMINI_API_KEY=
GROQ_API_KEY=

# Which model serves each tier, as provider:model. Leave empty to use the defaults in
# backend/finn/llm.py. Run `python -m finn.llm --check` from backend/ to list what your
# key can reach before choosing.
FINN_CHEAP_MODEL=
FINN_STRONG_MODEL=

# List prices in USD per 1M tokens, as {"model": [input, output]}, taken from the
# provider's pricing page. Used only to report cost; unpriced models show "not priced".
FINN_MODEL_PRICES=
# USD to INR rate used to show cost in rupees.
FINN_USD_INR=

# --- Optional enrichment --------------------------------------------------------------
# Web search for a new executive's background (management-change cards).
TAVILY_API_KEY=

# --- Backend --------------------------------------------------------------------------
# Comma-separated origins allowed to call the API (your Vercel URL). "*" while developing.
FINN_CORS_ORIGINS=*
# Where the SQLite database, snapshot and document cache live. Defaults to ./data
FINN_DATA_DIR=

# --- Frontend (set in frontend/.env.local or in Vercel) ---------------------------------
# Base URL of the deployed backend. Leave empty to run from the bundled snapshot only.
NEXT_PUBLIC_API_URL=
